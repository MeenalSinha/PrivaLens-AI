# Optional: only required if you want LLM-generated prose explanations in
# reports. Without it, PrivaLens falls back to a deterministic template
# explanation and every other feature works unchanged.
ANTHROPIC_API_KEY=

# Model used for LLM explanations (optional).
LLM_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Max upload size in bytes (default 10MB).
MAX_UPLOAD_BYTES=10485760
